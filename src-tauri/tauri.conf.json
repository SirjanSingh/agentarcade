{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentarcade",
  "version": "1.0.1",
  "identifier": "com.sirjan.agentarcade",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "agentarcade",
        "width": 560,
        "height": 620,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Mini-games while your coding agent thinks",
    "longDescription": "A tray app that shows a quick mini-game once your coding agent has been thinking for a while, and dismisses itself the moment it's done."
  }
}
