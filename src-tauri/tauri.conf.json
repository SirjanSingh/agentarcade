{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentarcade",
  "version": "2.1.0",
  "identifier": "com.sirjan.agentarcade",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "agentarcade",
        "width": 560,
        "height": 620,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src agpack: http://agpack.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Mini-games while your coding agent thinks",
    "longDescription": "A tray app that shows a quick mini-game once your coding agent has been thinking for a while, and dismisses itself the moment it's done.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SirjanSingh/agentarcade/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDNEQ2QTA5OTREQzZBM0UKUldRK2F0eVVDV3BOek5yZ0dqeVZJWXpsYnY2S1BoaWU1WFcycnU1T2NVQXFIOHVtS2UrUUU4YWUK"
    }
  }
}
